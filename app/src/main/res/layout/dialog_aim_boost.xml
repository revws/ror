<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ror_dialog"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ror_chip"
                android:padding="6dp"
                android:src="@drawable/ic_crosshair"
                app:tint="#FF0055" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aim Boost"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aim_active_mode_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Touch polling rate &amp; aim responsiveness"
                    android:textColor="#7A85A8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode Selection Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="AIM &amp; TOUCH ENGINE MODES"
            android:textColor="#7A85A8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Competitive Mode Card -->
        <LinearLayout
            android:id="@+id/aim_card_competitive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/ror_tool_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/aim_title_competitive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Competitive (480Hz Ultra-Low Latency)"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Zero swap interval (EGL 0), instant register, unfiltered raw touch."
                    android:textColor="#BAB6D2"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/aim_badge_competitive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/ror_chip"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="PRO GAMING"
                android:textColor="#FF0055"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Balanced Mode Card -->
        <LinearLayout
            android:id="@+id/aim_card_balanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/ror_tool_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/aim_title_balanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balanced (240Hz High Polling)"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Fast responsive polling, moderate touch boost, balanced power."
                    android:textColor="#BAB6D2"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/aim_badge_balanced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/ror_chip"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="RECOMMENDED"
                android:textColor="#00F5D4"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Efficient Mode Card -->
        <LinearLayout
            android:id="@+id/aim_card_efficient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/ror_tool_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/aim_title_efficient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Efficient (120Hz Standard)"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Stock touch response, maximum battery conservation, low thermal."
                    android:textColor="#BAB6D2"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/aim_badge_efficient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/ror_chip"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="BATTERY"
                android:textColor="#7A85A8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Interactive Touch Diagnostic Pad -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="LIVE INTERACTIVE TOUCH TEST PAD"
            android:textColor="#7A85A8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ror_tool_card_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Real-time Readouts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISPATCH DELAY"
                        android:textColor="#7A85A8"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/touch_val_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textColor="#00F5D4"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOUCH SAMPLING"
                        android:textColor="#7A85A8"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/touch_val_hz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- Hz"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIMING JITTER"
                        android:textColor="#7A85A8"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/touch_val_jitter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textColor="#FFA84B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POINTERS"
                        android:textColor="#7A85A8"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/touch_val_pointers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#2DE49A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Touch Interactive Area -->
            <FrameLayout
                android:id="@+id/touch_test_area"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#15FFFFFF">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:alpha="0.25"
                    android:src="@drawable/ic_crosshair"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/touch_hint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:text="Touch, swipe, or aim here to measure"
                    android:textColor="#80FFFFFF"
                    android:textSize="10.5sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_aim_apply"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ror_btn_primary"
                android:text="Apply Aim Mode"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_aim_close"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="0.8"
                android:layout_marginStart="6dp"
                android:background="@drawable/ror_btn_outline"
                android:text="Close"
                android:textColor="#7A85A8"
                android:textSize="11.5sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
