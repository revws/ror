<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070914"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#0C1024">

        <TextView
            android:id="@+id/app_manager_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ BACK"
            android:textColor="#D4D8F0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/ror_tool_card_bg" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ror_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP MANAGER"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/app_manager_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading applications..."
                android:textColor="#8892B0"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_manager_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REFRESH"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/ror_tool_card_bg" />
    </LinearLayout>

    <!-- Search Bar & Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="#0A0E20">

        <EditText
            android:id="@+id/app_search_input"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/ror_tool_card_bg"
            android:hint="Search installed applications..."
            android:textColorHint="#5A668C"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <!-- Filter Chips Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALL APPS"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/ror_tool_card_bg" />

            <TextView
                android:id="@+id/filter_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="USER APPS"
                android:textColor="#8892B0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/ror_tool_card_bg" />

            <TextView
                android:id="@+id/filter_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="SYSTEM APPS"
                android:textColor="#8892B0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/ror_tool_card_bg" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/app_manager_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Apps List View -->
    <ListView
        android:id="@+id/apps_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#141C38"
        android:dividerHeight="1dp"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>

