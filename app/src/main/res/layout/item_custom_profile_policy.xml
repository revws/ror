<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/ror_tool_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/item_policy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Policy 0 • LITTLE Cluster"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Governor -->
    <LinearLayout
        android:id="@+id/item_row_governor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scaling Governor"
            android:textColor="#D4D8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/item_val_governor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ror_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="schedutil"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#1B2446" />

    <!-- Min Freq -->
    <LinearLayout
        android:id="@+id/item_row_min_freq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Minimum Frequency"
            android:textColor="#D4D8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/item_val_min_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ror_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="300 MHz"
            android:textColor="#00ED74"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#1B2446" />

    <!-- Max Freq -->
    <LinearLayout
        android:id="@+id/item_row_max_freq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Maximum Frequency"
            android:textColor="#D4D8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/item_val_max_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ror_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="1.80 GHz"
            android:textColor="#FA476B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
