<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/ror_metric_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Icon Frame -->
    <FrameLayout
        android:id="@+id/wallet_icon_frame"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/ror_bottom_selected">

        <ImageView
            android:id="@+id/wallet_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_crypto"
            app:tint="#00E5FF" />
    </FrameLayout>

    <!-- Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wallet_network_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USDT • TRC20"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wallet_address_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="TDu77Susy3CzbkJGAjPRCGiVt5obBzypRb"
            android:textColor="#69DCFF"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Action Button (Copy / Open) -->
    <TextView
        android:id="@+id/wallet_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ror_chip"
        android:drawableStart="@drawable/ic_copy"
        android:drawablePadding="4dp"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="COPY"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        app:drawableTint="#FFFFFF" />

</LinearLayout>

