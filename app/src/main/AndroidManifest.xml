<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.revror.kernelmanager" >

    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="cyanogenmod.permission.PUBLISH_CUSTOM_TILE" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".RevrorApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/ic_banner"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true" >

        <meta-data
            android:name="com.revror.kernelmanager.BRAND_ID"
            android:value="REVROR" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity android:name=".activities.StartActivity" android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:exported="true" />
        <activity-alias android:name=".RegularLauncher" android:enabled="true"
            android:exported="true" android:icon="@mipmap/ic_launcher"
android:roundIcon="@mipmap/ic_launcher_round" android:label="ROR"
            android:targetActivity=".activities.StartActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".PhoenixLauncher" android:enabled="false"
            android:exported="true" android:icon="@mipmap/ic_phoenix_launcher"
            android:roundIcon="@mipmap/ic_phoenix_launcher_round" android:label="Phoenix"
            android:targetActivity=".activities.StartActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".activities.EulaActivity"
            android:screenOrientation="portrait"
            android:exported="true" />

        <activity android:name=".activities.DashboardActivity"
            android:screenOrientation="portrait"
            android:exported="true" />
        <activity android:name=".activities.RorProBenefitsActivity"
            android:screenOrientation="portrait"
            android:exported="true" />
        <activity android:name=".activities.GameLauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true" />

        <!-- Complete device-aware REVROR kernel manager. Unsupported panels are hidden at runtime. -->
        <activity android:name=".activities.StartActivityMaterial" android:enabled="false" android:exported="true" />
        <activity android:name=".activities.MainActivity" android:exported="false" />
        <activity android:name=".activities.NavigationActivity" android:exported="false" />
        <activity android:name=".activities.TextActivity" android:exported="false" />
        <activity android:name=".activities.AdvancedIOActivity" android:exported="false" />
        <activity android:name=".activities.ApplyScriptActivity" android:exported="false" />
        <activity android:name=".activities.BannerResizerActivity" android:exported="false" />
        <activity android:name=".activities.CPUBoostActivity" android:exported="false" />
        <activity android:name=".activities.ScriptEditorActivity" android:exported="false" />
        <activity android:name=".activities.FlashingActivity" android:exported="false" />
        <activity android:name=".activities.ForegroundActivity" android:exported="false" />
        <activity android:name=".activities.LaunchFragmentActivity" android:exported="false" />
        <activity android:name=".activities.NoRootActivity" android:exported="false" />
        <activity android:name=".activities.OverallActivity" android:exported="false" />
        <activity android:name=".activities.SecurityActivity" android:configChanges="locale|keyboard|keyboardHidden|orientation|screenSize|navigation" android:exported="false" />
        <activity android:name=".activities.tools.profile.ProfileActivity" android:exported="false" />
        <activity android:name=".activities.tools.profile.ProfileEditActivity" android:exported="false" />
        <activity android:name=".activities.TerminalActivity" android:exported="false" />
        <activity android:name=".activities.ToolsActivity" android:exported="false" />
        <activity android:name=".activities.TunablesActivity" android:exported="false" />
        <activity android:name=".activities.AppManagerActivity"
            android:screenOrientation="portrait"
            android:exported="true" />
        <activity android:name=".activities.KernelTuningActivity"
            android:screenOrientation="portrait"
            android:exported="true" />
        <activity android:name=".activities.WebViewActivity" android:exported="false" />
        <activity android:name=".views.NavHeaderView$MainHeaderActivity" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:exported="false" />
        <activity android:name=".activities.tools.profile.ProfileTaskerActivity" android:exported="true">
            <intent-filter><action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" /></intent-filter>
        </activity>

        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.provider"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/provider_paths" />
        </provider>

        <receiver
            android:name=".services.boot.OnBootReceiver"
            android:exported="true"
            android:enabled="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".services.CpuOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled live device performance overlay" />
        </service>
        <service
            android:name=".services.GameBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled in-game optimization control overlay" />
        </service>
        <service
            android:name="revror.kernelmanager.services.PowerButtonGestureService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled hardware power button shortcuts and auto-gaming profile detection" />
        </service>
        <receiver android:name=".services.ProfileScheduleReceiver" android:exported="false" />
        <receiver android:name=".services.CleanupReceiver" android:exported="false" />
        <service android:name=".services.boot.ApplyOnBootService" android:exported="false" />
        <receiver android:name=".services.boot.ApplyOnBoot$CancelReceiver" android:exported="false" />
        <receiver android:name=".services.profile.Widget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/profile_widget" />
        </receiver>
        <service android:name=".services.profile.Widget$WidgetService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />
        <receiver android:name=".services.profile.Tile" android:exported="false">
            <intent-filter><action android:name=".action.ACTION_TOGGLE_STATE" /></intent-filter>
        </receiver>
        <service android:name=".services.DashClock" android:icon="@drawable/ic_launcher_preview"
            android:permission="com.google.android.apps.dashclock.permission.READ_EXTENSION_DATA" android:exported="false">
            <intent-filter><action android:name="com.google.android.apps.dashclock.Extension" /></intent-filter>
            <meta-data android:name="protocolVersion" android:value="1" />
        </service>
        <receiver android:name=".services.profile.Tasker" android:exported="true">
            <intent-filter><action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" /></intent-filter>
        </receiver>
        <service android:name=".tiles.RevrorProfileTile" android:icon="@drawable/ic_revror_qs_profile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="REVROR Profile" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".tiles.RevrorGamingTile" android:icon="@drawable/ic_revror_qs_gaming"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="REVROR Gaming" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".tiles.RevrorCooldownTile" android:icon="@drawable/ic_revror_qs_cooldown"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="REVROR CoolDown" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".tiles.RevrorOverlayTile" android:icon="@drawable/ic_revror_qs_overlay"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="REVROR HUD" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".tiles.RevrorNightTile" android:icon="@drawable/ic_revror_qs_night"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="REVROR Night" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".tiles.ScriptTile" android:icon="@drawable/ic_revror_qs_script"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="REVROR Script" android:exported="true" android:enabled="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
    </application>
</manifest>
